#!/usr/bin/env python3

from pathlib import Path


PLAINTEXT_FILE = "plaintext.txt"
CIPHERTEXT_FILE = "cipher.txt"


def load_hex_file(filename):
    text = Path(filename).read_text()
    text = "".join(text.split())

    try:
        return bytes.fromhex(text)
    except ValueError as e:
        raise SystemExit(
            f"[-] Invalid hexadecimal data in {filename}: {e}"
        )


def xor_bytes(a, b):
    return bytes(x ^ y for x, y in zip(a, b))


def find_repeating_key(data):
    """
    Find the shortest exact repeating period.
    """

    for key_len in range(1, len(data) + 1):

        if len(data) % key_len != 0:
            # The key can still repeat with a partial final block,
            # so don't actually reject it here.
            pass

        key = data[:key_len]

        if all(
            data[i] == key[i % key_len]
            for i in range(len(data))
        ):
            return key

    return None


print("=" * 65)
print("KNOWN-PLAINTEXT XOR KEY RECOVERY")
print("=" * 65)


# ------------------------------------------------------------
# Load files
# ------------------------------------------------------------

try:
    plaintext = Path(PLAINTEXT_FILE).read_bytes()
except FileNotFoundError:
    raise SystemExit(
        f"[-] Cannot find {PLAINTEXT_FILE}"
    )


ciphertext = load_hex_file(CIPHERTEXT_FILE)


print()
print(f"[+] Plaintext length : {len(plaintext)} bytes")
print(f"[+] Ciphertext length: {len(ciphertext)} bytes")


# ------------------------------------------------------------
# Check lengths
# ------------------------------------------------------------

if len(plaintext) != len(ciphertext):

    print()
    print("[!] Length mismatch.")
    print()
    print("    This is important:")
    print("    plaintext and ciphertext must have the same")
    print("    length for direct XOR recovery.")
    print()
    print(
        f"    plaintext : {len(plaintext)}"
    )
    print(
        f"    ciphertext: {len(ciphertext)}"
    )

    raise SystemExit(1)


# ------------------------------------------------------------
# Derive XOR stream
# ------------------------------------------------------------

print()
print("[+] Deriving plaintext XOR ciphertext...")

keystream = xor_bytes(
    plaintext,
    ciphertext
)


print()
print("[+] First 128 derived bytes:")

print(
    keystream[:128].hex()
)


# ------------------------------------------------------------
# Search for repeating key
# ------------------------------------------------------------

print()
print("[+] Searching for repeating key...")

key = find_repeating_key(keystream)


if key is None:

    print()
    print("[-] No exact repeating key found.")

    raise SystemExit(1)


print()
print("=" * 65)
print("KEY RECOVERED")
print("=" * 65)

print()
print(f"Key length: {len(key)} bytes")

print()
print("Key hex:")

print(
    key.hex()
)


try:

    print()
    print("Key ASCII:")

    print(
        key.decode("ascii")
    )

except UnicodeDecodeError:

    print()
    print("Key contains non-ASCII bytes.")


# ------------------------------------------------------------
# Verify
# ------------------------------------------------------------

print()
print("[+] Verifying recovered key...")


recreated = bytes(
    plaintext[i] ^
    key[i % len(key)]
    for i in range(len(plaintext))
)


if recreated == ciphertext:

    print()
    print("[+] VERIFIED")
    print("[+] Recovered key reproduces the entire ciphertext.")

else:

    print()
    print("[-] Verification failed.")


# ------------------------------------------------------------
# Show repetitions
# ------------------------------------------------------------

print()
print("[+] Key repetitions:")

for i in range(0, len(keystream), len(key)):

    chunk = keystream[
        i:i + len(key)
    ]

    print(
        f"{i:04d}: "
        f"{chunk.decode(errors='replace')}"
    )


print()
print("=" * 65)
